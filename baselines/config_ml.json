{
  "data": {
    "pairs_tsv": "../data/pairs.tsv",
    "reference_fold_dir": "../data/splits",
    "pro1_sequence_csv": "../data/srnase_sequences.tsv",
    "pro2_sequence_csv": "../data/slf_sequences.tsv",
